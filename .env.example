# Backend
APP_NAME=CodePad Agent
APP_ENV=development
AGENT_PORT=8000
DATABASE_URL=sqlite:///./codepad.db
# Comma-separated origins. Use * only on a trusted local network.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Localhost, RFC1918 IPs, and *.local origins are allowed by this default regex.
# CORS_ORIGIN_REGEX=...

# Frontend (optional; when omitted, the browser uses its current host on port 8000)
VITE_API_BASE_URL=

# Gemini Error Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Notion Development Journal
NOTION_API_KEY=
# Preferred with Notion API 2026-03-11. Copy the data source ID from Notion.
NOTION_DATA_SOURCE_ID=
# Backward-compatible option: supported only when the database has one data source.
NOTION_DATABASE_ID=
NOTION_VERSION=2026-03-11
